# Copy to .env.local and adjust as needed. Every setting is optional.

# Where the SQLite database file lives.
# DATABASE_PATH=./data/prepchef.db

# Seed demo chefs, customers and bookings when the database is empty.
# SEED_DEMO_DATA=true

# Session cookies are marked Secure in production. Set to false only if you
# serve a production build over plain HTTP on a host other than localhost.
# SESSION_COOKIE_SECURE=true
